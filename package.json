{
  "name": "ikirere",
  "version": "1.0.0",
  "description": "Weather in your terminal. Geocodes a place, fetches a forecast, remembers your favourites.",
  "type": "module",
  "bin": {
    "ikirere": "./bin/ikirere.js"
  },
  "settings": { "units": "metric", 
  "defaultCity": "Kigali" },
  "favourites": [
    { "name": "Kigali",
     "country": "Rwanda", 
     "admin1": "Kigali City",
      "latitude": -1.95, "longitude": 30.06, "elevation": 1567, "timezone": "Africa/Kigali" }
  ],
  "history": [
    { "query": "Kigali",
     "place": "Kigali, Rwanda", 
     "at": "2026-11-07T13:46:29.151Z" }
  ],
  "files": [
    "bin",
    "src",
    "test"
  ],
  "scripts": {
    "start": "node bin/ikirere.js",
    "test": "node --test",
    "link": "npm link"
    
  },
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "weather",
    "cli",
    "open-meteo"
  ],
  "license": "MIT",
  "dependencies": {
    "axios": "^1.21.0"
  }
}
